# ========================================================
# Torbox Library Sync Addon - Environment Configuration
# Copy this file to '.env' and fill in your values.
# NEVER commit your real '.env' file to Git!
# ========================================================

# Port for local server (default: 7000)
PORT=7000

# TorBox API Key (Required for single-user self-hosting)
# Retrieve yours from https://torbox.app/settings
TORBOX_API_KEY=

# MDBList API Key (Optional - for title aliases & international mappings)
# Retrieve yours from https://mdblist.com/preferences/
MDBLIST_API_KEY=

# TVDB API Key (Optional - for enhanced TV series metadata validation)
# Retrieve yours from https://thetvdb.com/api-information
TVDB_API_KEY=
